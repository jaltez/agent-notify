# agent-notify systemd user unit for manual installs (contrib/install-systemd.sh).
# `agent-notify setup --service` writes this with the installed path baked in;
# keep the two in sync (internal/setup/agent-notify.service).
[Unit]
Description=agent-notify — herdr agent event notifier (headless)

[Service]
Type=simple
# Adjust the path if agent-notify lives elsewhere.
ExecStart=%h/.local/bin/agent-notify run
# always (not on-failure): the daemon exits cleanly on self-update and
# must come back on the new binary.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
